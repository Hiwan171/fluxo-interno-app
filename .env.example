# Copie para .env. Nunca versione o compartilhe o arquivo .env real.
TZ=America/Sao_Paulo

# Aplicação (publicada somente em localhost; use Caddy para HTTPS externo)
APP_IMAGE=fluxo-interno:local
APP_PORT=3000
APP_DOMAIN=fluxo.exemplo.com

# PostgreSQL. Use somente caracteres URL-safe na senha ou aplique URL encoding
# à senha dentro de DATABASE_URL.
POSTGRES_DB=fluxo_interno
POSTGRES_USER=fluxo_app
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fluxo_app:troque-por-uma-senha-longa-e-aleatoria@db:5432/fluxo_interno

# Gere com: openssl rand -base64 32
SESSION_SECRET=troque-por-no-minimo-32-bytes-aleatorios

# "log" não envia mensagens; "smtp" entrega ao servidor configurado abaixo.
# Desenvolvimento com Mailpit: smtp / mailpit / 1025 / false / usuário vazio.
EMAIL_MODE=smtp
MAIL_FROM=Fluxo Interno <noreply@empresa.com.br>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Portas locais do perfil dev (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
