# Copie para .env. Nunca versione o compartilhe o arquivo .env real.
TZ=America/Sao_Paulo

# Aplicação (publicada somente em localhost; use Caddy para HTTPS externo)
APP_IMAGE=fluxo-interno:local
APP_PORT=3000
APP_DOMAIN=fluxo.exemplo.com
# Redes que podem acessar o sistema todo (login, quadros, admin), separadas por
# espaco. De fora delas, so o formulario publico (/f/*) responde. Informe a faixa
# real da sua rede local e, se usar VPN, a faixa dela (Tailscale: 100.64.0.0/10).
# Nao inclua 172.16.0.0/12: e onde fica a rede bridge do Docker.
INTERNAL_NETS=192.168.0.0/16 10.0.0.0/8
# Base absoluta usada nos links enviados por e-mail (convite, redefinicao de senha).
# Sem ela, a URL e reconstruida a partir dos cabecalhos do proxy reverso.
APP_URL=https://fluxo.exemplo.com

# debug | info | warn | error. Padrao: info em producao, debug fora dela.
LOG_LEVEL=info

# PostgreSQL. Use somente caracteres URL-safe na senha ou aplique URL encoding
# à senha dentro de DATABASE_URL.
POSTGRES_DB=fluxo_interno
POSTGRES_USER=fluxo_app
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fluxo_app:troque-por-uma-senha-longa-e-aleatoria@db:5432/fluxo_interno


# "log" não envia mensagens; "smtp" entrega ao servidor configurado abaixo.
# Desenvolvimento com Mailpit: smtp / mailpit / 1025 / false / usuário vazio.
EMAIL_MODE=smtp
MAIL_FROM=Fluxo Interno <noreply@empresa.com.br>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# Exige STARTTLS na porta 587. Deixe true em producao (o padrao): sem isso a
# senha do SMTP pode trafegar em texto puro. So o Mailpit local precisa false.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=

# Portas locais do perfil dev (Mailpit)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Pasta de armazenamento dos anexos enviados via formulário/card.
# Em produção (docker-compose) aponta para o volume uploads_data.
UPLOADS_DIR=./uploads
