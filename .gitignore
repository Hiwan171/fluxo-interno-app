# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database backups
/backups/

# uploaded attachments (dev filesystem storage)
/uploads/

# relatórios e planilhas das importações do Pipefy (dados pessoais de chamados)
/import-report-*.json
*.xlsx

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arquivos de trabalho das ferramentas de contratos (contêm dados de clientes)
/scripts/contracts-tools/work/
